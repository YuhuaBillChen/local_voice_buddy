
# Settings; after a change, run: docker compose up -d
# How much conversation the model keeps in view, in tokens (32768 is about 50 pages; 65536 also fits in 32 GB).
CONTEXT=32768
# off: answers start right away. on: the model thinks first; better at hard questions, slow for voice.
THINKING=off
# Speech speed when Open WebUI asks for none (it never does). 1.0 is CosyVoice's natural pace.
SPEECH_SPEED=1.1
# Voice for new users; see "Your own voice" in README.md. Users can change it in Settings > Audio.
VOICE=default
# Built-in Open WebUI tools the model is offered, comma-separated (time, memory, chats, notes, knowledge, ...).
# Each one makes the start of every new chat slower; models can also be configured in Admin Settings > Models.
BUILTIN_TOOLS=time
# Port of the web interface. WEBUI_BIND=127.0.0.1 makes it reachable from this machine only.
WEBUI_PORT=3000
WEBUI_BIND=0.0.0.0
