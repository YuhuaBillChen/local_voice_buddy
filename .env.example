
# Settings; after a change, run: docker compose up -d
# How much conversation the model keeps in view, in tokens (32768 is about 50 pages; 65536 also fits in 32 GB).
CONTEXT=32768
# off: answers start right away. on: the model thinks first; better at hard questions, slow for voice.
THINKING=off
# Speech speed when Open WebUI asks for none (it never does). 1.0 is CosyVoice's natural pace.
SPEECH_SPEED=1.1
# Speech recognition search width, 1-8. Higher is slower and was not more accurate in our tests.
STT_BEAM_SIZE=1
# Voice Open WebUI starts with (see "Your own voice" in README.md). Read on its first start only;
# afterwards change it in Admin Settings > Audio, or per user in Settings > Audio.
VOICE=default
# Built-in Open WebUI tools the model is offered, comma-separated (time, memory, chats, notes, knowledge, ...).
# Each one makes the start of every new chat slower; models can also be configured in Admin Settings > Models.
BUILTIN_TOOLS=time,openui
# Optional external map tiles and remote images. Off keeps rendered answers offline.
OPENUI_NETWORK=false
# Port of the web interface. WEBUI_BIND=127.0.0.1 keeps it on this machine (Tailscale still reaches it);
# 0.0.0.0 opens it to your network: do that only after creating your account, the first one is the admin.
WEBUI_PORT=3000
WEBUI_BIND=127.0.0.1
